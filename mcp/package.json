{
  "name": "chalcp",
  "displayName": "ChalCP MCP Server",
  "description": "Model Context Protocol server with calculator and time tools - works as VS Code extension or standalone",
  "version": "0.1.3",
  "publisher": "chalcp",
  "license": "UNLICENSED",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Juan-Guzman-Ve/laughing-memory.git"
  },
  "bin": {
    "chalcp-mcp": "./dist/server/index.js"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18.0.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mcp-extension.start",
        "title": "MCP: Start Server"
      },
      {
        "command": "mcp-extension.stop",
        "title": "MCP: Stop Server"
      },
      {
        "command": "mcp-extension.restart",
        "title": "MCP: Restart Server"
      },
      {
        "command": "mcp-extension.testCalculator",
        "title": "MCP: Test Calculator Tool"
      },
      {
        "command": "mcp-extension.testTime",
        "title": "MCP: Test Time Tool"
      }
    ],
    "configuration": {
      "title": "MCP Server",
      "properties": {
        "mcpServer.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start the MCP server when VS Code starts"
        },
        "mcpServer.port": {
          "type": "number",
          "default": 3000,
          "description": "Port for the MCP server to listen on"
        },
        "mcpServer.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info",
          "description": "Log level for the MCP server"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts",
    "package": "vsce package --out ../artifacts",
    "pack": "npm run compile && npm pack --pack-destination ../artifacts",
    "build": "npm run compile",
    "start": "node dist/server/index.js"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/vsce": "^2.22.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-tools",
    "vscode-extension",
    "calculator"
  ]
}
